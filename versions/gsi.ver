#!/bin/bash
#
# WoFS GSI Build Environment
# NOAA Ursa - Intel OneAPI
#

# ============================================================
# Environment identification
# ============================================================

export MACHINE="ursa"
export COMPILER="intel"
export COMPONENT="gsi"

# ============================================================
# Intel compiler and MPI
# ============================================================

export COMPILER_VERSION="2023.2.0"
export MPI_VERSION="2021.13.1"

# ============================================================
# Build tools
# ============================================================

export CMAKE_VERSION="3.30.2"

# ============================================================
# I/O libraries
# ============================================================

export NETCDF_C_VERSION="4.9.2"
export NETCDF_FORTRAN_VERSION="4.6.1"
export HDF5_VERSION="1.14.3"
export PNETCDF_VERSION="1.12.3"

# ============================================================
# Supporting libraries
# ============================================================

export LIBTIRPC_VERSION="1.3.3"

# ============================================================
# Installation paths
# ============================================================

#export NETCDF_ROOT="/scratch3/NAGAPE/wof/netcdf"

export WRF_DIR="/scratch4/NCEPDEV/fv3-cam/Jianping.Huang/WoFS/WRF"

# Update this path to your actual GSI source directory
export GSI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../sorc/GSI" && pwd)"
